{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run bridge",
      "program": "${workspaceFolder}/bridge.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run bridge (watch / auto-restart)",
      "runtimeArgs": ["--watch"],
      "program": "${workspaceFolder}/bridge.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run diagnostics",
      "program": "${workspaceFolder}/diag.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "List serial ports",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ports"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
